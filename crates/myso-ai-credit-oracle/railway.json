{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "crates/myso-ai-credit-oracle/Dockerfile",
        "watchPatterns": [
            "crates/myso-ai-credit-oracle/**",
            "crates/myso-types/**",
            "crates/myso-sdk/**",
            "crates/myso-crypto/**",
            "crates/myso-json-rpc-types/**",
            "crates/myso-sdk-types/**",
            "crates/shared-crypto/**",
            "Cargo.toml",
            "Cargo.lock",
            "rust-toolchain.toml"
        ]
    },
    "deploy": {
        "runtime": "V2",
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "healthcheckPath": "/health"
    }
}
