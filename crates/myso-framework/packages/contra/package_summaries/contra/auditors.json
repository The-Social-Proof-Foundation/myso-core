  "structs": {
    "Auditors": {
      "index": 0,
      "doc": " Holds the set of auditor `public_keys` registered for a token. Auditors can decrypt the\n viewing-key ciphertexts attached to each transfer, giving them read access to transaction\n amounts without being able to move funds.\n\n The `version` number is incremented on every `update` so that `VerifiedKeyEncryption` values\n stored on user accounts can be checked for staleness. `recommended_min_version` is the issuer's\n advertised minimum `VerifiedKeyEncryption.version`; it is not enforced on chain. Wallets and\n other clients should treat any account whose `VerifiedKeyEncryption.version` is below it as\n stale and prompt the user to rotate before transferring.",
      "attributes": [],
      "abilities": [
        "Store"
      ],
      "type_parameters": [],
      "fields": {
        "positional_fields": false,
        "fields": {
          "pks": {
            "index": 0,
            "doc": null,
            "type_": {
              "vector": {
                "Datatype": {
                  "module": {
                    "address": "myso",
                    "name": "group_ops"
                  },
                  "name": "Element",
                  "type_arguments": [
                    {
                      "phantom": true,
                      "argument": {
                        "Datatype": {
                          "module": {
                            "address": "myso",
                            "name": "ristretto255"
                          },
                          "name": "G",
                          "type_arguments": []
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "version": {
            "index": 1,
            "doc": null,
            "type_": "u32"
          },
          "recommended_min_version": {
            "index": 2,
            "doc": null,
            "type_": "u32"
          }
        }
      }
    },
    "VerifiedKeyEncryption": {
      "index": 1,
      "doc": " A user's viewing key encrypted to each auditor's public key, stored on their account after\n passing a `KeyConsistencyProof` check. The `version` records which auditor key set it was\n produced against, so callers can compare it against `Auditors.recommended_min_version` to\n detect encryptions that the issuer considers stale.\n\n An empty `ciphertext` means the user's account was registered while the token had no\n auditors set.",
      "attributes": [],
      "abilities": [
        "Copy",
        "Drop",
        "Store"
      ],
      "type_parameters": [],
      "fields": {
        "positional_fields": false,
        "fields": {
          "ciphertext": {
            "index": 0,
            "doc": null,
            "type_": {
              "vector": {
                "Datatype": {
                  "module": {
                    "address": "contra",
                    "name": "twisted_elgamal"
                  },
                  "name": "MultiRecipientEncryption",
                  "type_arguments": []
                }
              }
            }
          },
          "version": {
            "index": 1,
            "doc": null,
            "type_": "u32"
          }
        }
      }
    },
    "KeyEncryption": {
      "index": 2,
      "doc": " A user's viewing key encrypted to each auditor's public key, bundled with the\n proofs needed to register it on-chain:\n - `proof` is the `KeyConsistencyProof` showing each limb of `ciphertext` correctly\n   encrypts the matching 32-bit limb of the user's private key under every auditor's\n   public key, and that the limbs sum to `sender_public_key`'s discrete log.\n - `range_proof` is an aggregate Bulletproof showing every limb's plaintext lies\n   in `[0, 2^32)` so that auditors can recover each limb via baby-step giant-step.",
      "attributes": [],
      "abilities": [
        "Drop"
      ],
      "type_parameters": [],
      "fields": {
        "positional_fields": false,
        "fields": {
          "ciphertext": {
            "index": 0,
            "doc": null,
            "type_": {
              "vector": {
                "Datatype": {
                  "module": {
                    "address": "contra",
                    "name": "twisted_elgamal"
                  },
                  "name": "MultiRecipientEncryption",
                  "type_arguments": []
                }
              }
            }
          },
          "proof": {
            "index": 1,
            "doc": null,
            "type_": {
              "Datatype": {
                "module": {
                  "address": "contra",
                  "name": "nizk"
                },
                "name": "KeyConsistencyProof",
                "type_arguments": []
              }
            }
          },
          "range_proof": {
            "index": 2,
            "doc": null,
            "type_": {
              "vector": "u8"
            }
          }
        }
      }
    }
