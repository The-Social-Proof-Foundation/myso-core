    "verify_key_encryption": {
      "source_index": 12,
      "index": 12,
      "doc": " Resolve an `Option<KeyEncryption>` against the configured `auditors` and produce a\n `VerifiedKeyEncryption`. When auditors are set, a `KeyEncryption` must be provided; the\n sigma proof and the aggregate Bulletproof over the limb commitments are both checked\n before returning. When auditors are not set, no `KeyEncryption` may be provided and an\n empty placeholder is returned. Aborts with `EMissingEncryptedViewingKeyArguments` /\n `ETooManyEncryptedViewingKeyArguments` on mismatch.",
      "attributes": [],
      "visibility": "Package",
      "entry": false,
      "type_parameters": [],
