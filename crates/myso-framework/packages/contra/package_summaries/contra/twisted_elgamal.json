                    "argument": {
                      "Datatype": {
                        "module": {
                          "address": "myso",
                          "name": "ristretto255"
                        },
                        "name": "G",
                        "type_arguments": []
                      }
                    }
                  }
                ]
              }
            }
          },
          "decryption_handle": {
            "index": 1,
            "doc": null,
            "type_": {
              "Datatype": {
                "module": {
                  "address": "myso",
                  "name": "group_ops"
                },
