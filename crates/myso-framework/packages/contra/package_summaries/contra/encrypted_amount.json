    "new_well_formed_proof": {
      "source_index": 2,
      "index": 2,
      "doc": " Bundle range proofs and consistency proofs into a `WellFormedProof`. Pass one consistency\n proof per amount and one range proof per `batch_sizes(consistency_proofs.length())` chunk,\n where each chunk's range proof covers that chunk's amounts (4 limbs each). Aborts on length\n mismatch or empty `range_proofs[i]`; proofs are not verified here — callers must call\n `verify`.",
      "attributes": [],
      "visibility": "Public",
      "entry": false,
      "type_parameters": [],
      "parameters": [
        {
          "name": "range_proofs",
          "type_": {
            "vector": {
              "vector": "u8"
            }
          }
        },
        {
          "name": "consistency_proofs",
          "type_": {
            "vector": {
              "Datatype": {
                "module": {
                  "address": "contra",
                  "name": "encrypted_amount"
                },
                "name": "ConsistencyProof",
                "type_arguments": []
              }
            }
          }
        }
      ],
      "return_": [
        {
          "Datatype": {
            "module": {
              "address": "contra",
              "name": "encrypted_amount"
            },
            "name": "WellFormedProof",
            "type_arguments": []
          }
        }
      ]
    },
    "verify": {
      "source_index": 3,
      "index": 3,
      "doc": " Check `proof` against `amounts` under `pks` and `dst`: every limb of every amount is u16 and\n each amount is a valid ElGamal encryption to its matching `pks[i]`. Returns `false` on any\n verification failure; aborts only on length mismatch between `amounts`, `pks`, and\n `proof.consistency_proofs`. An empty `proof.range_proofs` skips the range check\n entirely — only reachable via the `#[test_only]` constructor; `new_well_formed_proof` rejects\n empty input.",
